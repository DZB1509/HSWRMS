# Local Developer Override Profile
# Run with: --spring.profiles.active=dev

spring:
  datasource:
    url: jdbc:sqlserver://localhost:1433;databaseName=HSWRMS;encrypt=true;trustServerCertificate=true
    username: sa
    password: YourLocalPasswordHere
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    com.heavenstay.hswrms: DEBUG
    org.springframework.security: DEBUG

# To test real SMTP email delivery instead of the dev console-logger adapter:
# 1. Run Spring Boot with: --spring.profiles.active=dev,smtp
# 2. Provide SMTP credentials via environment variables:
#    export MAIL_HOST=smtp.gmail.com
#    export MAIL_PORT=587
#    export MAIL_USERNAME=your.email@gmail.com
#    export MAIL_PASSWORD=your-16-char-app-password
#    export MAIL_FROM=your.email@gmail.com
# (Never commit real email passwords or tokens)
