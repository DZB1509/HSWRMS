server:
  port: 8080

spring:
  application:
    name: hswrms

  datasource:
    # Set DB_HOST, DB_PORT, DB_NAME, DB_USERNAME, DB_PASSWORD in your environment
    url: jdbc:sqlserver://${DB_HOST:localhost}:${DB_PORT:1433};databaseName=${DB_NAME:HSWRMS};encrypt=true;trustServerCertificate=true
    username: ${DB_USERNAME:sa}
    password: ${DB_PASSWORD:YourStrong@Password}
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.SQLServerDialect

app:
  jwt:
    # In production, provide a strong 256+ bit random key through JWT_SECRET environment variable
    secret: ${JWT_SECRET:ReplaceWithAStrong256BitSecretKeyInProductionEnvironment}
    expiration-ms: 86400000
  cors:
    allowed-origins: http://localhost:5173,http://localhost:4173
