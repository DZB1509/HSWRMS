# ==============================================================================
# HSWRMS Backend Environment Template (Local Development)
# DO NOT store real production secrets in tracked files.
# ==============================================================================

# Mandatory: JWT Signing Secret (must be at least 32 UTF-8 bytes / 256 bits)
# Generate securely via PowerShell:
#   $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); $env:JWT_SECRET = [Convert]::ToBase64String($bytes)
# Generate securely via OpenSSL:
#   export JWT_SECRET=$(openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Optional Database Configurations (when using SQL Server instead of H2)
# DB_HOST=localhost
# DB_PORT=1433
# DB_NAME=HSWRMS
# DB_USERNAME=sa
# DB_PASSWORD=YourLocalPasswordHere

# Optional Developer Feature Toggles
# APP_DEMO_BOOTSTRAP_ENABLED=false
# APP_AUTH_DEV_TOKEN_ENABLED=false
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

