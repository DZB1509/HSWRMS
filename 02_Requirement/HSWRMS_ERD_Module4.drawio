ce&lt;/td&gt;&lt;td&gt;DECIMAL (VND)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="1">
