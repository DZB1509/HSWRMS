:#0F172A;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;IsAvailable&lt;/td&gt;&lt;td&gt;BOOLEAN (Khả dụng phục vụ hôm nay)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#F43F5E;strokeWidth=2;" vertex="1" parent="1">
