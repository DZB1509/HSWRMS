        </mxCell>

        <!-- 7. FOLIO_CHARGE_ITEM (M5 Context) -->
        <mxCell id="entity_folio_charge" value="&lt;table border=&quot;1&quot; width=&quot;100%&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse; background-color:#1E293B; color:#F8FAFC; border-color:#0284C7; font-family:sans-serif; font-size:11px;&quot;&gt;&lt;tr style=&quot;background-color:#0284C7; color:#FFFFFF; text-align:center;&quot;&gt;&lt;td colspan=&quot;3&quot;&gt;&lt;b style=&quot;font-size:13px;&quot;&gt;FOLIO_CHARGE_ITEM&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:10px; color:#E0F2FE;&quot;&gt;(Khoản Phí Folio - M5 Context)&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#334155; color:#38BDF8; font-weight:bold;&quot;&gt;&lt;td width=&quot;35&quot; align=&quot;center&quot;&gt;Key&lt;/td&gt;&lt;td&gt;Attribute Name&lt;/td&gt;&lt;td&gt;Data Type / Notes&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align=&quot;center&quot; style=&quot;color:#F43F5E; font-weight:bold;&quot;&gt;PK&lt;/td&gt;&lt;td&gt;&lt;b&gt;ChargeItemID&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT (Auto Increment)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#0F172A;&quot;&gt;&lt;td align=&quot;center&quot; style=&quot;color:#38BDF8; font-weight:bold;&quot;&gt;FK&lt;/td&gt;&lt;td&gt;&lt;b&gt;FolioID&lt;/b&gt;&lt;/td&gt;&lt;td&gt;INT (Ref GUEST_FOLIO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;ChargeDate&lt;/td&gt;&lt;td&gt;DATE (Ngày phát sinh phí)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#1E3A8A;&quot;&gt;&lt;td align=&quot;center&quot; style=&quot;color:#FACC15;&quot;&gt;★&lt;/td&gt;&lt;td style=&quot;color:#FACC15;&quot;&gt;&lt;b&gt;ChargeType&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;color:#FACC15;&quot;&gt;&lt;b&gt;ENUM ('EXTRA_FB', 'EXTRA_SPA'...)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;Description&lt;/td&gt;&lt;td&gt;VARCHAR (Mô tả đơn a-la-carte)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#0F172A;&quot;&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;Amount&lt;/td&gt;&lt;td&gt;DECIMAL (Số tiền phụ thu BR-04)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;PaymentStatus&lt;/td&gt;&lt;td&gt;ENUM (PENDING, PAID, WAIVED)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;shadow=1;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1720" y="240" width="440" height="310" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- BUSINESS RULE CALLOUT CARDS (NOTES)                          -->
        <!-- ============================================================ -->

        <!-- Note BR-03 -->
        <mxCell id="note_br03" value="&lt;b style=&quot;font-size: 12px; color: #38BDF8;&quot;&gt;BR-03: Allergy Data Filter Logic&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border-color: #334155;&quot;/&gt;1. System reads &lt;b&gt;GUEST_HEALTH_PROFILE.FoodAllergies&lt;/b&gt; during ordering.&lt;br/&gt;2. Cross-checks with &lt;b&gt;MENU_ITEM.AllergenTags&lt;/b&gt;.&lt;br/&gt;3. Automatically inserts warning string into &lt;b&gt;MEAL_ORDER_LINE.AllergyWarning&lt;/b&gt;.&lt;br/&gt;4. Chef &amp; F&amp;B Staff see ONLY food allergy warnings; all medical conditions remain strictly hidden." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#1E293B;fontColor=#CBD5E1;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacing=8;size=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="440" height="230" as="geometry" />
        </mxCell>

        <!-- Note BR-04 -->
        <mxCell id="note_br04" value="&lt;b style=&quot;font-size: 12px; color: #FACC15;&quot;&gt;BR-04: Extra F&amp;B Charge Auto-Posting&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border-color: #334155;&quot;/&gt;1. Meals included in retreat package have &lt;b&gt;IsALaCarte = FALSE&lt;/b&gt; (Price = 0 VND).&lt;br/&gt;2. Additional/custom orders have &lt;b&gt;IsALaCarte = TRUE&lt;/b&gt;.&lt;br/&gt;3. Upon order confirmation, system automatically calculates &lt;i&gt;SUM(Quantity * UnitPrice)&lt;/i&gt; and creates a &lt;b&gt;FOLIO_CHARGE_ITEM&lt;/b&gt; with &lt;b&gt;ChargeType = 'EXTRA_FB'&lt;/b&gt; linked to the Guest's Folio." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#1E293B;fontColor=#CBD5E1;strokeColor=#FACC15;strokeWidth=1.5;fontSize=10;align=left;verticalAlign=top;spacing=8;size=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="660" width="440" height="230" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- RELATIONSHIPS & EDGES                                        -->
        <!-- ============================================================ -->

        <!-- 1. ROOM_BOOKING ||--o{ MEAL_ORDER -->
        <mxCell id="rel_booking_order" value="1 : N (places / has meal orders)&lt;br/&gt;&lt;font color=&quot;#F472B6;&quot;&gt;FK: RoomBookingID&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F43F5E;strokeWidth=2.5;fontColor=#F472B6;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;startArrow=ERone;startSize=10;endArrow=ERmany;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_room_booking" target="entity_meal_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2. MEAL_ORDER ||--o{ MEAL_ORDER_LINE -->
        <mxCell id="rel_order_line" value="1 : N (contains order lines)&lt;br/&gt;&lt;font color=&quot;#F472B6;&quot;&gt;FK: MealOrderID&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F43F5E;strokeWidth=2.5;fontColor=#F472B6;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;startArrow=ERone;startSize=10;endArrow=ERmany;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_meal_order" target="entity_meal_order_line">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. MENU_ITEM ||--o{ MEAL_ORDER_LINE -->
        <mxCell id="rel_menu_line" value="1 : N (selected in order line)&lt;br/&gt;&lt;font color=&quot;#F472B6;&quot;&gt;FK: MenuItemID&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F43F5E;strokeWidth=2.5;fontColor=#F472B6;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;startArrow=ERone;startSize=10;endArrow=ERmany;endSize=10;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_menu_item" target="entity_meal_order_line">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. GUEST_HEALTH_PROFILE ..> note_br03 ..> MEAL_ORDER_LINE (BR-03 Flow) -->
        <mxCell id="flow_health_br03" value="FoodAllergies Data Input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;strokeDasharray=4 4;fontColor=#38BDF8;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;endArrow=open;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_health_profile" target="note_br03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_br03_line" value="Generates AllergyWarning (BR-03)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;strokeDasharray=4 4;fontColor=#38BDF8;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;endArrow=open;endSize=8;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="note_br03" target="entity_meal_order_line">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="1255" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 5. MEAL_ORDER ..> note_br04 ..> FOLIO_CHARGE_ITEM (BR-04 Flow) -->
        <mxCell id="flow_order_br04" value="IsALaCarte = TRUE (Extra Charge)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FACC15;strokeWidth=2;strokeDasharray=4 4;fontColor=#FACC15;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;endArrow=open;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_meal_order" target="note_br04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_br04_folio" value="Auto-posts ChargeItem (EXTRA_FB)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FACC15;strokeWidth=2;strokeDasharray=4 4;fontColor=#FACC15;fontSize=10;fontStyle=1;labelBackgroundColor=#0F172A;endArrow=open;endSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="note_br04" target="entity_folio_charge">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1940" y="775" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 6. STAFF_ACCOUNT -> MENU_ITEM & MEAL_ORDER -->
        <mxCell id="flow_staff_menu" value="FB_STAFF / Chef updates IsAvailable &amp; prepares meal orders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=1.5;strokeDasharray=3 3;fontColor=#38BDF8;fontSize=10;labelBackgroundColor=#0F172A;endArrow=open;endSize=6;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entity_staff_account" target="entity_menu_item">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="520" />
              <mxPoint x="1440" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
